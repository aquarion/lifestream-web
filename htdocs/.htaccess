RewriteEngine On

#RewriteCond %{HTTP_HOST} ^nicholasavenell\.com [NC]
#RewriteCond %{SERVER_PORT} 80 
#RewriteRule ^(.*)$ https://nicholasavenell.com/$1 [R,L]

RewriteRule cv.*        https://docs.google.com/document/d/1ToerY5WNhYYTh1xLy-IGf1h8n-CVygtynQQ1Nn7eXsk/view [R,L]
RewriteRule assets.*	-	[L]
RewriteRule favicon.ico	-	[L]
RewriteRule index.php	-	[L]
RewriteRule api -	[L]
RewriteRule .*\.php	-	[L]
RewriteRule fetchNext.php	-	[L]
RewriteRule annual.* -	[L]
RewriteRule .*	/index.php	[L]
